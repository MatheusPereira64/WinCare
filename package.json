{
  "name": "wincare",
  "productName": "WinCare",
  "version": "1.0.5",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "knip": "knip --no-config-hints",
    "quality": "npm run lint && npm run typecheck && npm run knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "wincare:build": "vite build --config vite.electron.config.ts",
    "wincare:dev": "vite build --config vite.electron.config.ts && node scripts/run-electron-dev.cjs",
    "wincare:admin": "vite build --config vite.electron.config.ts && node scripts/run-electron-dev.cjs --admin",
    "wincare:dev:debug": "vite build --config vite.electron.config.ts && set WINCARE_DEVTOOLS=1&& set ELECTRON_ENABLE_LOGGING=1&& node scripts/run-electron-dev.cjs",
    "wincare:clear-data": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clear-wincare-data.ps1",
    "wincare:package": "node scripts/package-release.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/router-plugin": "^1.168.18",
    "apexcharts": "^6.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-apexcharts": "^2.1.1",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "@eslint/js": "^10.0.1",
    "@lovable.dev/vite-tanstack-config": "^2.8.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.15.0",
    "knip": "^6.35.1",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.1.5"
  },
  "main": "electron/main.cjs"
}
